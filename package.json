{
  "name": "gudopick",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-media-library": "~58.0.13",
    "expo-router": "~58.0.30",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "gudopick-vision": "file:modules/gudopick-vision",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-vision-camera": "^5.2.4",
    "react-native-vision-camera-worklets": "^5.2.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "nitrogen": "^0.37.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "specs": "cd modules/gudopick-vision && nitrogen",
    "licenses": "node scripts/generate-licenses.mjs",
    "android:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-build.ps1 assembleDebug",
    "android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-build.ps1 assembleRelease"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/tests/unit/**/*.test.ts",
      "**/tests/integration/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "react-native-gesture-handler"
      ]
    }
  }
}
