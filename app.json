{
  "expo": {
    "name": "구도픽",
    "slug": "gudopick",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "gudopick",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.gudopick.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "구도픽",
        "CFBundleDevelopmentRegion": "ko",
        "NSCameraUsageDescription": "카메라 화면에서 피사체 위치를 기기 안에서 분석해 구도 가이드를 보여주고, 직접 셔터를 눌러 사진을 촬영하기 위해 사용해요.",
        "NSPhotoLibraryAddUsageDescription": "촬영 결과에서 '저장하기'를 눌렀을 때 사진을 사진 앱에 추가하기 위해 사용해요. 기존 사진은 읽지 않아요.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.gudopick.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/brand/android-icon-foreground.png",
        "monochromeImage": "./assets/brand/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.MANAGE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "촬영 결과에서 '저장하기'를 눌렀을 때 사진을 사진 앱에 추가하기 위해 사용해요. 기존 사진은 읽지 않아요.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      "expo-sqlite",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
